<Window x:Class="PracticeMate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PracticeMate.App.Views"
        Title="PracticeMate 管樂練習助手" Width="1280" Height="820" MinWidth="960" MinHeight="640"
        Background="{StaticResource WindowBrush}" FontFamily="Microsoft JhengHei UI">
    <TabControl TabStripPlacement="Left" Background="{StaticResource WindowBrush}" BorderThickness="0" Padding="0"
                SelectedIndex="{Binding CurrentPage, Converter={StaticResource PageToIndex}}">
        <TabItem Header="調音器">
            <views:TunerView DataContext="{Binding Tuner}" />
        </TabItem>
        <TabItem Header="節拍器">
            <views:MetronomeView DataContext="{Binding Metronome}" />
        </TabItem>
        <TabItem Header="錄音">
            <views:RecordingView DataContext="{Binding Recording}" />
        </TabItem>
        <TabItem Header="分析">
            <views:AnalysisView DataContext="{Binding Analysis}" />
        </TabItem>
        <TabItem Header="響度">
            <views:LoudnessView DataContext="{Binding Analysis}" />
        </TabItem>
        <TabItem Header="設定">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>

<UserControl x:Class="PracticeMate.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PracticeMate.App.Controls"
             xmlns:s="clr-namespace:PracticeMate.App.Services"
             xmlns:vms="clr-namespace:PracticeMate.App.ViewModels.Services;assembly=PracticeMate.App.ViewModels">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="110" />
            <RowDefinition Height="2*" MinHeight="140" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="開啟錄音…" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="取消分析" Command="{Binding CancelCommand}" />
            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
            <ProgressBar Width="220" Height="10" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="8,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ProgressStage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,6,0,6">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" />
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="#F2B84B" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="滾輪縮放、拖曳平移、雙擊顯示全部；波形與頻譜圖同步。" Style="{StaticResource Muted}" FontSize="11" />
        </StackPanel>

        <c:WaveformView Grid.Row="2" Waveform="{Binding Result.Waveform}" Timeline="{Binding Timeline}"
                        s:ChartExport.Kind="{x:Static vms:ChartKind.Waveform}" Margin="0,0,0,4" />
        <c:SpectrogramView Grid.Row="3" Spectrogram="{Binding Result.Spectrogram}" Timeline="{Binding Timeline}"
                           LogFrequency="{Binding DataContext.Settings.SpectrogramLogFrequency, RelativeSource={RelativeSource AncestorType=Window}}"
                           s:ChartExport.Kind="{x:Static vms:ChartKind.Spectrogram}" />

        <TabControl Grid.Row="4" Margin="0,8,0,0" Background="{StaticResource PanelBrush}" BorderThickness="0">
            <TabItem Header="音準報告">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <Button Content="匯出 CSV" Command="{Binding ExportNotesCsvCommand}" />
                        <Button Content="匯出 PNG" Command="{Binding ExportPngCommand}" CommandParameter="{x:Static vms:ChartKind.NoteDeviation}" />
                        <Button Content="波形 PNG" Command="{Binding ExportPngCommand}" CommandParameter="{x:Static vms:ChartKind.Waveform}" />
                        <Button Content="頻譜圖 PNG" Command="{Binding ExportPngCommand}" CommandParameter="{x:Static vms:ChartKind.Spectrogram}" />
                    </StackPanel>
                    <c:NoteDeviationChart Grid.Row="1" Items="{Binding Notes}" s:ChartExport.Kind="{x:Static vms:ChartKind.NoteDeviation}" />
                    <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Notes}" Margin="8,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                            <DataGridTextColumn Header="開始(秒)" Binding="{Binding StartSeconds, StringFormat=F2}" />
                            <DataGridTextColumn Header="結束(秒)" Binding="{Binding EndSeconds, StringFormat=F2}" />
                            <DataGridTextColumn Header="音名" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="音分" Binding="{Binding CentsText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="節拍報告">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Bpm, UpdateSourceTrigger=LostFocus}" Width="60" />
                        <TextBlock Text="BPM　第一拍" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Text="{Binding FirstBeatSeconds, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="70" />
                        <TextBlock Text="秒" VerticalAlignment="Center" Margin="6,0,16,0" />
                        <Button Content="匯出 CSV" Command="{Binding ExportBeatsCsvCommand}" />
                        <Button Content="匯出 PNG" Command="{Binding ExportPngCommand}" CommandParameter="{x:Static vms:ChartKind.BeatDeviation}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BeatSummary}" FontSize="15" Margin="0,0,0,6" />
                    <c:BeatDeviationChart Grid.Row="2" Items="{Binding Beats}" s:ChartExport.Kind="{x:Static vms:ChartKind.BeatDeviation}" />
                    <DataGrid Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Beats}" Margin="8,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="拍" Binding="{Binding BeatNumber}" />
                            <DataGridTextColumn Header="拍點(秒)" Binding="{Binding BeatSeconds, StringFormat=F3}" />
                            <DataGridTextColumn Header="偏差(ms)" Binding="{Binding DeviationMs, StringFormat=+0.0;-0.0;0.0}" />
                            <DataGridTextColumn Header="" Binding="{Binding Kind}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="PracticeMate.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="設定" Style="{StaticResource Heading}" />
            <GroupBox Header="音高">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="標準音 A4（Hz）" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding A4, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding A4Error}" Foreground="{StaticResource DangerBrush}" Visibility="{Binding A4Error, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Grid.Row="2" Text="樂器調性" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Width="340" HorizontalAlignment="Left"
                              ItemsSource="{Binding Transpositions}" SelectedItem="{Binding Transposition}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TranspositionName}}" Foreground="Black" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="雜訊門檻（dBFS）" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding NoiseGateDbfs}" Width="80" HorizontalAlignment="Left" />
                </Grid>
            </GroupBox>
            <GroupBox Header="裝置">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="錄音裝置" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding CaptureDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CaptureDeviceId}" />
                    <TextBlock Grid.Row="1" Text="輸出裝置（節拍器）" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding RenderDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding RenderDeviceId}" />
                    <Button Grid.Row="2" Grid.Column="1" Content="重新整理裝置清單" Command="{Binding RefreshDevicesCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </Grid>
            </GroupBox>
            <GroupBox Header="頻譜圖">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="視窗大小" Width="160" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding SpectrogramWindows}" SelectedItem="{Binding SpectrogramWindow}" Width="100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="重疊（%）" Width="160" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SpectrogramOverlap, Converter={StaticResource FractionToPercent}}" Width="80" />
                    </StackPanel>
                    <TextBlock Text="{Binding OverlapError}" Foreground="{StaticResource DangerBrush}" Margin="160,4,0,0" Visibility="{Binding OverlapError, Converter={StaticResource NullToCollapsed}}" />
                    <CheckBox Content="對數頻率軸" IsChecked="{Binding SpectrogramLogFrequency}" Margin="160,8,0,0" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="響度（團內規定）">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="目標整合響度（LUFS）" Width="160" VerticalAlignment="Center" />
                        <TextBox Text="{Binding NormalizationTargetLufs}" Width="80" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="真峰值上限（dBTP）" Width="160" VerticalAlignment="Center" />
                        <TextBox Text="{Binding TruePeakCeilingDbtp}" Width="80" />
                    </StackPanel>
                    <TextBlock Text="{Binding NormalizationError}" Foreground="{StaticResource DangerBrush}" Margin="160,4,0,0" Visibility="{Binding NormalizationError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="錄音">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="存放資料夾" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding RecordingFolder}" Width="360" />
                </StackPanel>
            </GroupBox>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8">
                <Run Text="資料夾留白時使用：" /><Run Text="{Binding DefaultRecordingFolder, Mode=OneWay}" />
            </TextBlock>
            <Button Content="儲存設定" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

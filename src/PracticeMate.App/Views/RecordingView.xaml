<UserControl x:Class="PracticeMate.App.Views.RecordingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PracticeMate.App.Controls">
    <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="錄音" Style="{StaticResource Heading}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
            <Button Content="● 開始錄音" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="■ 停止" Command="{Binding StopCommand}" />
            <Button Content="分析這段錄音" Command="{Binding AnalyzeCommand}" />
            <TextBlock Text="{Binding ElapsedText}" FontSize="28" FontWeight="SemiBold" Margin="24,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="輸入電平（−60 到 0 dBFS；細線為峰值）" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <c:LevelMeter PeakFraction="{Binding PeakMeterFraction}" RmsFraction="{Binding RmsMeterFraction}" Height="22" />
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="峰值" Style="{StaticResource Muted}" />
            <TextBlock Grid.Column="1" Text="{Binding PeakDbfs, StringFormat={}{0:F1} dBFS}" />
            <TextBlock Grid.Row="1" Text="RMS" Style="{StaticResource Muted}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RmsDbfs, StringFormat={}{0:F1} dBFS}" />
            <TextBlock Grid.Row="2" Text="緩衝區溢位" Style="{StaticResource Muted}" />
            <TextBlock Grid.Row="2" Grid.Column="1">
                <Run Text="{Binding OverflowCount, Mode=OneWay}" /><Run Text=" 次（遺失 " /><Run Text="{Binding DroppedFrames, Mode=OneWay}" /><Run Text=" 個取樣框）" />
            </TextBlock>
            <TextBlock Grid.Row="3" Text="檔案" Style="{StaticResource Muted}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastRecordingPath}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Status}" />
        <TextBlock Text="錄音期間每秒更新一次檔頭；即使程式當機，已錄的內容仍可讀取。" Style="{StaticResource Muted}" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
